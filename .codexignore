# — General macOS noise —
.DS_Store
Thumbs.db

# — Xcode build artifacts —
build/
Build/
*.xcarchive

# — Swift Package Manager —
.swiftpm/
.packages/
Package.resolved

# — Carthage / Cocoapods (if present) —
Carthage/
Pods/

# — Swift Generated Files —
*.gyb

# — Logs & Reports —
*.log
*.xcactivitylog
report.xml

# — IDE Workspace / User State —
*.xccheckout
*.xcscmblueprint
*.swp
*.swo
*.orig
*.lok
*.lock
*.xcuserstate
*.xcuserdata/

