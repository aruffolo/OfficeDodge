Assets.xcassets/

# — Documentation / Large Markdown files —
docs/
Documentation/
*.md

# — Third-party folders —
node_modules/
vendor/

# — App bundles & binaries —
*.app
*.ipa
*.dmg
*.framework
*.xcframework
*.a

# — Secrets / Environment —
.env
*.key
*.pem
*.p12

# — JSON, YAML, and other large raw data files —
*.yaml
*.yml
*.xml
*.csv
*.plist

# — Test output —
*.profdata
*.coverage
